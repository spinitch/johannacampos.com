<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{#- title/description arrive already escaped: pages set them via eleventyComputed templates. #}
<title>{{ title | safe }}</title>
<meta name="description" content="{{ description | safe }}">
{%- if og %}
<meta property="og:title" content="{{ title | safe }}">
<meta property="og:description" content="{{ og.description | safe }}">
<meta property="og:url" content="{{ og.url }}">
{%- endif %}
<link rel="icon" href="assets/img/logo-mark.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/site.css">
{%- if tabs %}
<script>document.documentElement.classList.add('js');</script>
{%- endif %}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<!-- SHARED: nav -->
<header class="site-nav">
  <a href="index.html" class="nav-brand" aria-label="Johanna Campos — home">
    <img class="nav-mark" src="assets/img/logo-mark.png" alt="" width="27" height="24">
    <span class="nav-wordmark">Johanna Campos</span>
  </a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu"><span></span><span></span><span></span></button>
  <nav aria-label="Main">
    <ul class="nav-links" id="nav-links">
      <li><a href="how-i-can-help.html"{% if current == "services" %} aria-current="page"{% endif %}>Services</a></li>
      <li><a href="index.html#work">Work</a></li>
      <li><a href="about.html"{% if current == "about" %} aria-current="page"{% endif %}>About</a></li>
      <li><a href="contact.html"{% if current == "contact" %} aria-current="page"{% endif %}>Contact</a></li>
    </ul>
  </nav>
</header>

<main id="main"{% if mainClass %} class="{{ mainClass }}"{% endif %}>
{{ content | safe }}
</main>
{% if not hideCta %}
<!-- SHARED: CTA band -->
<section class="cta-band" id="contact">
  <div class="cta-col">
    <p class="eyebrow">{{ site.email_cta.eyebrow }}</p>
    <h2>{{ site.email_cta.heading | heading | safe }}</h2>
    <a class="btn-primary" href="contact.html">{{ site.email_cta.button }}</a>
  </div>
  <div class="cta-col">
    <p class="eyebrow">{{ site.book_cta.eyebrow }}</p>
    <h2>{{ site.book_cta.heading | heading | safe }}</h2>
    <a class="btn-primary" href="{{ site.booking_url }}" target="_blank" rel="noopener">{{ site.book_cta.button }}</a>
  </div>
</section>
{% endif %}
<!-- SHARED: footer -->
<footer class="site-footer">
  <a href="index.html" class="footer-logo">Johanna Campos</a>
  <nav class="footer-links" aria-label="Footer">
    <a href="index.html#work">Work</a>
    <a href="how-i-can-help.html">Services</a>
    <a href="about.html">About</a>
    <a href="{{ site.linkedin_url }}" target="_blank" rel="noopener">LinkedIn</a>
  </nav>
  <p class="footer-copy">{{ site.copyright }}</p>
</footer>

<script src="assets/js/site.js" defer></script>
</body>
</html>
